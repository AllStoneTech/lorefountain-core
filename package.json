{
  "name": "lorefountain-core",
  "version": "0.3.0",
  "description": "LoreFountain's shared parsing core: Fountain scripts, shot and cue maps, entity and manifest schemas. Read and parse only.",
  "author": "Louis (All Stone Tech)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AllStoneTech/lorefountain-core.git"
  },
  "type": "commonjs",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "fountain-js": "^1.2.4",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.1"
  }
}
